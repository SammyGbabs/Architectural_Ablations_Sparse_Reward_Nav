# Ignore the virtual environment directory
Rl_Summative/

# Ignore Python bytecode files
*.pyc
*.pyo
__pycache__/

# Ignore system-specific files
.DS_Store  # macOS
Thumbs.db  # Windows

# Ignore IDE-specific files
.vscode/
.idea/
.ipynb_checkpoints/

# Scratch / exploratory notebooks (not version-controlled)
Notebooks/scratch/

# Experiment tracking and training artifacts
wandb/
*.tfevents.*
*_tensorboard/
*.zip
*.npz

# Generated figure exports (PNGs are tracked; vector/PDF exports are not)
figures/*.svg
figures/*.pdf

# positive-control MNIST cache
data/

# LaTeX build (paper/) — track the source (main.tex, *.sty, *.bst, references.bib);
# ignore compiled output and intermediates. The packaged supplementary archive
# (paper/supplementary_material.zip) is already covered by the global *.zip rule above.
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/*.toc

# LaTeX build (paper/tae/) — TAE workshop version; track source, ignore output
paper/tae/*.pdf
paper/tae/*.aux
paper/tae/*.log
paper/tae/*.out
paper/tae/*.bbl
paper/tae/*.blg
paper/tae/*.synctex.gz
paper/tae/*.fdb_latexmk
paper/tae/*.fls
paper/tae/*.bak
paper/tae/*.prev
